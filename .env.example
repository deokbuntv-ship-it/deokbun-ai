EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional — production web canonical/OG/sitemap base URL (client-safe, non-secret).
# Production value (set in Vercel, not here): https://www.deokbunai.com. Omit in dev.
EXPO_PUBLIC_PUBLIC_BASE_URL=
# Optional — Naver Login Client ID (PUBLIC; appears in the authorize URL) for the
# edge-bridge Naver login. The Naver Client SECRET is an EDGE secret, NEVER here.
EXPO_PUBLIC_NAVER_CLIENT_ID=

# 검색엔진 소유확인 (선택 — 웹 빌드 시각에만 쓰인다).
# 값이 없으면 메타 태그를 **넣지 않는다**. 빈 값을 넣으면 콘솔이 "값이 다르다" 로 읽어 확인이 실패한다.
# Vercel Production 환경변수에 넣으면 dist/index.html 의 <head> 에 한 장씩 들어간다.
EXPO_PUBLIC_GOOGLE_SITE_VERIFICATION=
EXPO_PUBLIC_NAVER_SITE_VERIFICATION=

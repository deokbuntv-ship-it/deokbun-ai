EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional — production web canonical/OG/sitemap base URL (client-safe, non-secret).
# Production value (set in Vercel, not here): https://www.deokbunai.com. Omit in dev.
EXPO_PUBLIC_PUBLIC_BASE_URL=
# Optional — Supabase Custom OAuth provider slug for Naver (default: custom:naver).
# Only set if the Supabase Dashboard custom provider was named differently.
EXPO_PUBLIC_NAVER_SUPABASE_PROVIDER=
